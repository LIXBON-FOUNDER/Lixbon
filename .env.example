# lixbon — Configuración del gateway
# Copia este archivo como .env y completa los valores.
# En Railway estas variables se definen en el servicio (no se usa .env).

# ── Base de datos (Postgres) ────────────────────────────────────────────────
# En desarrollo: URL pública de lixbon-staging en Railway.
# En producción: Railway la inyecta automáticamente al enlazar el servicio Postgres.
# NUNCA pongas aquí la URL de producción.
DATABASE_URL=postgresql://usuario:password@host.railway.app:5432/railway

# ── Redis (rate limiting / sesiones) ────────────────────────────────────────
# En desarrollo: URL pública del Redis de staging en Railway. Vacío = fallback en memoria.
REDIS_URL=

# ── Ollama / nodos GPU ──────────────────────────────────────────────────────
# URL base del Ollama local (fallback cuando no hay nodos online)
OLLAMA_BASE_URL=http://127.0.0.1:11434

# ── Roles de inferencia (mapa rol→modelo) ───────────────────────────────────
# Cinco roles con requisitos incompatibles: chat/agente, fim (autocompletado),
# vision, embed y route (clasificador de delegación). Ver
# docs/CUELLO_DE_BOTELLA_MODELOS.md.
# Vacío = el gateway autodetecta por la capability que declara Ollama
# (tools / vision / embedding / insert). La tabla `model_roles` del panel admin
# tiene prioridad sobre estas variables.
MODEL_ROLE_CHAT=deepseek-r1:8b
# Requiere capability `insert` (tokens FIM). Ni deepseek-r1 ni qwen3 la tienen:
# hace falta un modelo de código, p. ej. qwen2.5-coder:1.5b. Vacío = ghost text
# desactivado, que es mejor que disparar el modelo de chat en cada pulsación.
MODEL_ROLE_FIM=
MODEL_ROLE_VISION=moondream
MODEL_ROLE_EMBED=nomic-embed-text
MODEL_ROLE_ROUTE=

# Residencia en VRAM por rol (`keep_alive` de Ollama).
# "30m" | "-1" permanente | "0" descargar ya | "" no enviar nada.
# Dimensionado para UNA GPU con un solo modelo grande residente (6 GB):
# nunca pongas -1 en CHAT si el modelo ocupa casi toda la VRAM.
MODEL_KEEPALIVE_CHAT=30m
MODEL_KEEPALIVE_FIM=10m
MODEL_KEEPALIVE_VISION=60s
MODEL_KEEPALIVE_EMBED=-1
MODEL_KEEPALIVE_ROUTE=5m

# Cachés (segundos): roles de BD y catálogo de modelos.
MODEL_ROLES_TTL_S=60
MODELS_CACHE_TTL_S=10

# ── API / CORS ───────────────────────────────────────────────────────────────
# Orígenes permitidos separados por coma. En producción: tu dominio real.
ALLOWED_ORIGINS=http://localhost:5173

# ── Rate limiting ────────────────────────────────────────────────────────────
RATE_LIMIT_PER_MIN=120
AUTH_RATE_LIMIT=5
AUTH_BLOCK_MINUTES=15

# ── Admin ────────────────────────────────────────────────────────────────────
# Token para acciones administrativas (subida de releases). Genera uno con:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_TOKEN=

# ── Claves y sesiones ────────────────────────────────────────────────────────
KEY_EXPIRY_DAYS=90
SESSION_EXPIRY_HOURS=24

# ── Logging ──────────────────────────────────────────────────────────────────
# json (producción/Railway) | plain (desarrollo)
LOG_FORMAT=plain
LOG_LEVEL=INFO

# ── Node Agent (solo en las PCs con GPU, no en Railway) ─────────────────────
# Token que exige el agente; debe coincidir con el registrado para este nodo
# en el panel admin del gateway (POST /api/admin/nodes lo genera).
NODE_SHARED_SECRET=
AGENT_PORT=8765
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_WATCHDOG=1

# ── Auth (F3) ────────────────────────────────────────────────────────────────
# Emails (separados por coma) que se promueven automáticamente a rol admin
ADMIN_EMAILS=
# "1" en producción (cookies solo por HTTPS); "0" en desarrollo local
COOKIE_SECURE=0
# URL pública del gateway (para links de verificación/reset en los emails)
PUBLIC_BASE_URL=http://localhost:8000
# "1" = con el correo sin verificar se puede entrar y ver la cuenta, pero no
# usar el servicio (chat y API responden 403). Encenderlo SOLO cuando el correo
# salga de verdad: la única forma de desbloquearse es recibir un correo, así que
# con Brevo mal configurado deja fuera a todo el mundo a la vez.
# Compruébalo antes con: python scripts/probar_correo.py tu@correo.com
REQUIRE_EMAIL_VERIFICATION=0

# ── Lixbon Team ──────────────────────────────────────────────────────────────
# Secreto con el que se firman las URLs de los adjuntos del chat. Un `<img src>`
# no manda cabeceras, así que la autorización de un adjunto vive en la firma de
# su URL; sin este valor se inventa uno al arrancar y los enlaces ya repartidos
# dejan de valer en cada redespliegue (el cliente los renueva solo, pero se nota).
# Genéralo con:  python -c "import secrets;print(secrets.token_hex(32))"
TEAM_URL_SECRET=
# Los adjuntos se guardan en el mismo bucket de R2 que los releases: sin R2
# configurado, subir un archivo al chat responde 503 y el resto de Team funciona.

# ── Correo transaccional (Brevo) ─────────────────────────────────────────────
# Vacío = modo dev: el correo se escribe en el log en vez de enviarse, así que
# el flujo entero (registro → verificación → bienvenida) se puede probar sin red.
# La clave se saca de Brevo → SMTP & API → API keys.
BREVO_API_KEY=
# El dominio de EMAIL_FROM tiene que estar dado de alta Y autenticado en Brevo
# (Senders, Domains & Dedicated IPs → Domains), con sus registros SPF y DKIM en
# el DNS. Sin eso Brevo rechaza cada envío, o los correos acaban en spam. El SPF
# se FUSIONA con el que ya haya en el dominio: dos registros SPF lo invalidan.
#   v=spf1 include:_spf.mx.cloudflare.net include:spf.brevo.com ~all
EMAIL_FROM=lixbon <no-reply@lixbon.com>
