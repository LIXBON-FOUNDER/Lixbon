      "stream": "data: {\"choices\": [{\"delta\": {\"content\": \"antes\"}}]}\n\ndata: [DONE]\n\ndata: {\"choices\": [{\"delta\": {\"content\": \"despues\"}}]}\n\n",
      "events": [
        [
          "content",
