{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "app-folax",
  "version": "0.1.0",
  "identifier": "com.usuario.app-folax",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "app-folax",
        "width": 800,
        "height": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDkyQTAzQjU0RjM1NkUxMTYKUldRVzRWYnpWRHVna3FzZHVxR1gzck5KeGRLTThPSjdvN21wS1pQZTVVNktaZGU2aVhncmkzZTcK",
      "endpoints": [
        "https://remote.datacentgbx.online/api/updates/manifest/stable"
      ]
    }
  }
}
