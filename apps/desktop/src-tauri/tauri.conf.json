{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Lixbon",
  "version": "2.0.2",
  "identifier": "com.usuario.app-lixbon",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Lixbon",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 600,
        "center": true,
        "decorations": false,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data: blob: https: http://127.0.0.1:*; connect-src 'self' https: wss: ws://localhost:* http://localhost:* ipc: http://ipc.localhost; frame-src http://localhost:* http://127.0.0.1:* https:"
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDkyQTAzQjU0RjM1NkUxMTYKUldRVzRWYnpWRHVna3FzZHVxR1gzck5KeGRLTThPSjdvN21wS1pQZTVVNktaZGU2aVhncmkzZTcK",
      "endpoints": [
        "https://lixbon.com/api/updates/manifest/stable"
      ]
    }
  }
}
