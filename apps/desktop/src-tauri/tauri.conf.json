{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "app-lixbon",
  "version": "0.5.0",
  "identifier": "com.usuario.app-lixbon",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "LIXBON",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 600,
        "center": true,
        "decorations": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data:; connect-src 'self' https: ws://localhost:* http://localhost:* ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDkyQTAzQjU0RjM1NkUxMTYKUldRVzRWYnpWRHVna3FzZHVxR1gzck5KeGRLTThPSjdvN21wS1pQZTVVNktaZGU2aVhncmkzZTcK",
      "endpoints": [
        "https://lixbon.com/api/updates/manifest/stable"
      ]
    }
  }
}
