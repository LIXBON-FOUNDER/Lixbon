    { "secret": "ñandú ✓", "payload": "go-keyring-base64:w7FhbmTDuiDinJM=" }
  ],
  "macos_decode_only": [
    { "payload": "go-keyring-encoded:616263", "secret": "abc" },
    { "payload": "abc", "secret": "abc" },
    { "payload": "go-keyring-encoded:c3b1616e64c3ba20e29c93", "secret": "ñandú ✓" }
  ],
  "macos_decode_invalid": [
    "go-keyring-base64:!!!no-es-base64",
